<mxfile host="app.diagrams.net">
  <diagram name="User overview" id="overview">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="650" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;touchid-gate: AWS login with your fingerprint&lt;/b&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="700" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="With touchid-gate, Granted keeps your SSO token out of the login keychain. It is encrypted with a key inside the Secure Enclave, and every read needs your finger." style="text;html=1;fontSize=13;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="46" width="1290" height="26" as="geometry" />
        </mxCell>

        <mxCell id="flowhdr" value="&lt;b&gt;On every assume&lt;/b&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="300" height="24" as="geometry" />
        </mxCell>

        <mxCell id="s1" value="&lt;b&gt;1 · Terminal&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;assume &amp;lt;profile&amp;gt;&lt;/font&gt;&lt;br&gt;(optionally with --exec)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="110" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 · Wrapper&lt;/b&gt;&lt;br&gt;touchid-gate starts the real granted and gives it access to the store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="240" y="110" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 · granted&lt;/b&gt;&lt;br&gt;needs your SSO token and asks the store for it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="110" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 · Store&lt;/b&gt; (touchid-gate)&lt;br&gt;checks: is it really granted asking? Is the key unchanged?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="110" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;5 · Touch ID prompt&lt;/b&gt;&lt;br&gt;shows the caller and the command. You place your finger" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="110" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="&lt;b&gt;6 · Secure Enclave&lt;/b&gt;&lt;br&gt;computes the key for the token. The private key never leaves the chip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1120" y="110" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="s7" value="&lt;b&gt;7 · Back to granted&lt;/b&gt;&lt;br&gt;touchid-gate hands the token to granted through a pipe and never writes it to disk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="250" width="410" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="&lt;b&gt;8 · AWS&lt;/b&gt;&lt;br&gt;granted exchanges the token for STS credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="460" y="250" width="410" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="&lt;b&gt;9 · Your command runs&lt;/b&gt;&lt;br&gt;with the credentials in its environment until the role session expires" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="20" y="250" width="410" height="70" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a2" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a3" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a4" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a5" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a6" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;edgeStyle=orthogonalEdgeStyle;exitX=0.5;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="s6" target="s7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a7" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="s7" target="s8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a8" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#666666;" edge="1" parent="1" source="s8" target="s9"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="files" value="&lt;b&gt;Where things live&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;~/.granted/config&lt;/font&gt;: makes granted use the store (&lt;font face=&quot;Menlo&quot;&gt;Backend = &quot;pass&quot;&lt;/font&gt;)&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;~/.granted/enclave-store/&lt;/font&gt;: your tokens, encrypted&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;~/.config/touchid-gate/config.json&lt;/font&gt;: which programs may ask, key pin&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;~/.local/touchid-gate/bin/&lt;/font&gt;: wrappers for granted, assumego, aws-vault (first in PATH)&lt;br&gt;&lt;br&gt;&lt;b&gt;Changed your fingerprints?&lt;/b&gt; The old key stops working:&lt;br&gt;&lt;font face=&quot;Menlo&quot;&gt;rm -r ~/.granted/enclave-store; touchid-gate init granted&lt;/font&gt;, then log in via SSO once." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ffffff;strokeColor=#999999;fontSize=12;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="360" width="640" height="170" as="geometry" />
        </mxCell>

        <mxCell id="yes" value="&lt;b&gt;Protects you against&lt;/b&gt;&lt;br&gt;&lt;br&gt;• a copy of the disk, backups, Time Machine&lt;br&gt;• other users on the Mac&lt;br&gt;• scripts, AI agents and malware that only read files&lt;br&gt;• swapped or forged entries in the store" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="360" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="no" value="&lt;b&gt;Does not protect against&lt;/b&gt;&lt;br&gt;&lt;br&gt;• a prompt you approve although you did not start it&lt;br&gt;• credentials already handed to running commands (until they expire)&lt;br&gt;• someone who permanently rewires your account (config, programs)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="1010" y="360" width="300" height="170" as="geometry" />
        </mxCell>

        <mxCell id="rule" value="&lt;b&gt;Rule of thumb:&lt;/b&gt; only place your finger if you just started the command shown in the prompt yourself." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;arcSize=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="550" width="1290" height="40" as="geometry" />
        </mxCell>

        <mxCell id="leg1" value="touchid-gate / Granted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="610" width="160" height="26" as="geometry" />
        </mxCell>
        <mxCell id="leg2" value="macOS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="190" y="610" width="100" height="26" as="geometry" />
        </mxCell>
        <mxCell id="leg3" value="Hardware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="610" width="100" height="26" as="geometry" />
        </mxCell>
        <mxCell id="leg4" value="you / AWS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="410" y="610" width="100" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
