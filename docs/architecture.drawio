ml=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="28" y="90" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-9" value="2. gate mode: load config, gates[assumego], realpath + owner/mode/ACL check, not self" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="238" y="168" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-10" value="3. prompt false: no Touch ID; withPass: PATH = libexec:$PATH; execv(granted)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="238" y="246" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-11" value="4. keyring pass backend: stat &amp;lt;PassDir&amp;gt;/granted-aws-sso-tokens/&amp;lt;key&amp;gt;.gpg" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="448" y="324" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-12" value="5. exec pass show granted-aws-sso-tokens/&amp;lt;key&amp;gt; PASSWORD_STORE_DIR = PassDir" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="448" y="402" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-13" value="6. strict argv, normalise name, load config, dir must be a configured store, checkParents" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="658" y="480" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-14" value='7. caller check: getppid → SecCode matches callers csreq → "granted (Team &amp;lt;TEAMID&amp;gt;)"' style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="658" y="558" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-15" value="8. open entry fd-relative (O_NOFOLLOW | O_NONBLOCK, ≤ 2 MiB), decode Box" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="1288" y="636" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-16" value="9. pin check: load seKey (unevaluated LAContext), publicKey matches, sha256(S.pub ‖ M ‖ policy) == key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="658" y="714" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-17" value='10. Touch ID: "unlock your AWS SSO login for granted (Team &amp;lt;TEAMID&amp;gt;)" + caller command' style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="868" y="792" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-18" value="11. SE key agreement: ECDH(S, M) → HKDF → Kmac" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="1078" y="870" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-19" value="12. MAC verify: ephemeral 65 bytes, HMAC(name, ephemeral, sealed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="658" y="948" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-20" value="13. decrypt: ECDH(S, ephemeral) → HKDF(name) → AES-GCM open" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#FFFFFF;strokeColor=#333333;spacing=3;" vertex="1" parent="1"><mxGeometry x="1078" y="1026" width="184" height="56" as="geometry"/></mxCell><mxCell id="f-21" value="14. getppid unchanged → plaintext SSO token to stdout" style="rounded=1;whiteSpace=wrap;html=1;fontSize=